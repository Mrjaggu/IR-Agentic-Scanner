# Model Provider Selection (GROQ | GEMINI | OPENAI)
MODEL_PROVIDER=GROQ

# Model Specific Configurations
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini

# API Keys (Set these in your deployment environment or locally)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Optional -- News feeds tab's external headlines (thenewsapi.com, free tier:
# 100 requests/day). App runs fine without it; that tab just shows an
# "isn't configured" message instead of headlines.
THE_NEWS_API_TOKEN=your_thenewsapi_token_here
