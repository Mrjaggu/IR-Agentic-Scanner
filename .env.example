# Model Provider Selection (GROQ | GEMINI | OPENAI)
MODEL_PROVIDER=GROQ

# Model Specific Configurations
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini

# API Keys (Set these in your deployment environment or locally)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Optional -- News feeds tab's external headlines (thenewsapi.com, free tier:
# 100 requests/day). App runs fine without it; that tab just shows an
# "isn't configured" message instead of headlines.
THE_NEWS_API_TOKEN=your_thenewsapi_token_here

# Optional -- chat "Listen" (text-to-speech) button. Nothing to set for the
# normal case: the voice model auto-downloads itself the first time it's
# needed on a deployment like Vercel where it was never manually installed
# (src/tts/piper_tts.py). Set PIPER_AUTO_DOWNLOAD=0 to disable that and keep
# Listen strictly manual-install-only (e.g. a genuinely air-gapped deploy).
PIPER_AUTO_DOWNLOAD=1
